  "training": {
    "optimizer": "AdamW",
    "scheduler": "CosineAnnealingLR",
    "scheduler_interval": "optimizer_step",
    "precision": "fp32",
    "batch_size": 1,
    "initialization": "highest_validation_psnr_backbone_checkpoint",
    "teacher": "frozen_matching_backbone",
    "retain_native_spatial_loss": true,
    "retain_native_fourier_loss": true,
    "native_fourier_weight": 1.0,
    "consistency": 0.30,
    "second_order_multiplier": 2.0,
    "teacher_distillation": 0.05,
    "checkpoint_selection": "highest_validation_psnr"
  }
}
