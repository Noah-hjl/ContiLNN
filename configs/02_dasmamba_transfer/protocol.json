{
  "editor": "Jialei.He",
  "paper_order": 2,
  "experiment": "contilnn_dasmamba_transfer",
  "backbone": "DASMamba",
  "operator": "bidirectional_cfc",
  "num_seeds": 5,
  "model": {
    "dim": 48,
    "cfc_hidden": 256
  },
  "modalities": {
    "CT": {"train_cases": 8, "validation_cases": 1, "test_cases": 1, "epoch_cap": 60},
    "MRI": {"train_cases": 405, "validation_cases": 58, "test_cases": 114, "epoch_cap": 100},
    "PET": {"train_cases": 120, "validation_cases": 10, "test_cases": 29, "epoch_cap": 60}
  },
  "data": {
    "sequence_length": 7,
    "patch_size": 128,
